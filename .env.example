# Slack credentials for the LD move calculator app.
# Copy to .env and fill in real values (never commit .env).

# Bot token (xoxb-...) — needs scopes: commands, chat:write
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing secret from the app's Basic Information page (used in HTTP mode)
SLACK_SIGNING_SECRET=your-signing-secret

# App-level token (xapp-...) with connections:write — set ONLY to use Socket Mode.
# Leave blank/unset to run in HTTP mode instead.
SLACK_APP_TOKEN=

# HTTP mode port (ignored in socket mode). Defaults to 3000.
PORT=3000
